#!/usr/bin/env bash
set -euo pipefail

: "${DOKUWIKI_SOURCE:?run this check through nix develop}"

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
tmpdir=$(mktemp -d)
trap 'rm -rf "$tmpdir"' EXIT

cp -R "$DOKUWIKI_SOURCE"/. "$tmpdir/dokuwiki"
chmod -R u+w "$tmpdir/dokuwiki"
ln -s "$root" "$tmpdir/dokuwiki/lib/plugins/vpsadmindoc"

rendered=$(
  printf '%s\n' \
    '<kb-managed source="contract/pages/manuals-vps-kvm.txt" test="kb/kvm#*" />' \
    '<kb-managed source="https://github.com/vpsfreecz/vpsfree-kb-contracts/blob/master/contract/pages/manuals-vps-kvm.txt" test="https://github.com/vpsfreecz/vpsfree-kb-contracts/blob/master/tests/suite/kb/kvm.nix" />' \
    '<vpsadmin-nav id="member.public-keys.add">Public keys & more</vpsadmin-nav>' \
    | php "$tmpdir/dokuwiki/bin/render.php"
)

expected='<span class="vpsadmindoc-nav" data-vpsadmin-doc-id="member.public-keys.add">Public keys &amp; more</span>'
if [[ "$rendered" != *"$expected"* ]]; then
  printf 'DokuWiki integration output did not contain expected annotation:\n%s\n' "$rendered" >&2
  exit 1
fi
if [[ "$rendered" == *'kb-managed'* || "$rendered" == *'vpsfree-kb-contracts'* \
  || "$rendered" == *'contract/pages'* || "$rendered" == *'kb/kvm'* ]]; then
  printf 'managed-page marker unexpectedly rendered XHTML:\n%s\n' "$rendered" >&2
  exit 1
fi

invalid=$(
  printf '%s\n' '<kb-managed source="https://example.test/not-github" />' \
    | php "$tmpdir/dokuwiki/bin/render.php"
)
if [[ "$invalid" != *'data-vpsadmin-doc-error="invalid-managed-page"'* ]]; then
  printf 'invalid managed-page marker did not render a diagnostic:\n%s\n' "$invalid" >&2
  exit 1
fi

echo 'DokuWiki integration check passed'
